# 主服务数据库；默认对应 just db-up 启动的 ParadeDB 容器
DATABASE_URL=postgres://borges:borges@127.0.0.1:5432/borges

# 本地解析 worker；just parser-serve 默认监听 127.0.0.1:8001
PARSER_WORKER_URL=http://127.0.0.1:8001
PARSER_TIMEOUT_MS=180000

# rg 沙箱镜像根目录，按 source_id 分子目录
MIRROR_ROOT=.data/mirror

# 超边抽取用的 OpenAI 兼容 LLM；仅信源开启 extract_hyperedge 时调用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# 向量化；入库与检索共用，三项必填
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=30000

# Rerank；hybrid 与 hyperedge 精排必填，构造检索引擎时统一校验
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_TIMEOUT_MS=30000

# rg 单次检索超时（毫秒）
RG_TIMEOUT_MS=10000

# 解析 worker 上游凭据
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_POLL_INTERVAL_S=3
MINERU_POLL_TIMEOUT_S=600
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
